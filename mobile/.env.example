[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# Timetable Mobile — environment template
# Copy to .env and fill in values. Only PUBLIC values live here —
# secrets (Gemini keys, DB credentials, OAuth secrets) must never
# appear in the mobile app. All cloud calls go through the Express
# backend using the Passport session cookie.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (the existing Express server).
# Local dev: http://localhost:5000
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# ── Google OAuth (optional — hides the Google button when empty) ──
# A Google Cloud OAuth client with the Web application type, or the native
# Android/iOS client IDs. The mobile app sends the ID token to
# POST /api/auth/google/mobile on the backend, which verifies it.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
