{
  "name": "automatic-timetable-scheduler",
  "productName": "Automatic Timetable Scheduler",
  "version": "1.0.2",

  "type": "module",
  "license": "MIT",
  "description": "Offline desktop timetable scheduler for schools and colleges (Electron + SQLite + OR-Tools).",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:client": "vite dev",
    "dev:electron": "npm run build:electron && node script/launch-electron.cjs",
    "dev:python": "cd python-service && venv\\Scripts\\python.exe -m uvicorn app:app --host 127.0.0.1 --port 8000 --reload",
    "check": "tsc",
    "test": "npm run test:parse && npm run test:templates && npm run test:updater",
    "test:parse": "tsx script/test-import-parse.ts",
    "test:templates": "tsx script/test-pdf-templates.ts",
    "test:updater": "tsx script/test-updater.ts",
    "build": "vite build",

    "build:electron": "tsx script/build-electron.ts",
    "build:solver": "tsx script/build-solver.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "desktop:dev": "npm run dev:electron",
    "desktop:smoke": "npm run build:electron && node script/launch-electron.cjs --smoke",
    "desktop:build": "npm run build && npm run build:electron && npm run build:solver && electron-builder --win",
    "desktop:build:all": "npm run build && npm run build:electron && npm run build:solver && electron-builder --win --linux",
    "desktop:build:dir": "npm run build && npm run build:electron && electron-builder --dir",

    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "better-sqlite3": "github:WiseLibs/better-sqlite3#v12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.13.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "5.6.3",
    "vite": "^7.3.0"
  }
}
